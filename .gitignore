# ============================================================
# Fire Guard Robot - Git Ignore Rules
# ============================================================

# Dependencies
node_modules/
**/node_modules/

# Production & Build Artifacts
dist/
**/dist/
dist-ssr/
**/dist-ssr/
*.tsbuildinfo
**/*.tsbuildinfo

# Environment variables & Private secrets
.env
.env.local
.env.*.local
*.local

# Arduino / PlatformIO / Embedded Build Outputs
build/
**/build/
.arduino/
*.hex
*.bin
*.elf

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS & Editor Files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
